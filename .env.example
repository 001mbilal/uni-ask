# SQLite database path (default: data/uni.db relative to project root)
# DB_PATH=data/uni.db

# Anthropic API key — required for the chat endpoint
ANTHROPIC_API_KEY=sk-ant-...

# Models (defaults shown; override to use a different version)
# ANSWER_MODEL=claude-sonnet-5-5
# QUERY_MODEL=claude-haiku-5-5

# Voyage AI key — required for embedding (set EMBEDDINGS_PROVIDER=mock to skip)
VOYAGE_API_KEY=pa-...

# EMBEDDINGS_PROVIDER=voyage   # or "mock" for offline testing
# EMBEDDING_MODEL=voyage-3.5

# Crawler settings
CRAWL_CONTACT=your-email@example.com   # included in User-Agent string
# CRAWL_MAX_PAGES=150
# CRAWL_MAX_DEPTH=3
# CRAWL_DELAY_MS=1000
# CRAWL_CONCURRENCY=4

# Retrieval settings
# TOP_K=8
# MIN_SCORE=0.25
