# Copy to .env and fill in

# Claude (answers + query understanding): https://console.anthropic.com
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-5-5
QUERY_MODEL=claude-haiku-5-5

# Voyage AI (embeddings): https://www.voyageai.com
# Set EMBEDDINGS_PROVIDER=mock to test the pipeline offline (poor search quality)
EMBEDDINGS_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5

# Crawler
# Identify yourself so university IT teams can contact you
CRAWL_CONTACT=your-email@example.com
CRAWL_MAX_PAGES=150
CRAWL_MAX_DEPTH=3
CRAWL_DELAY_MS=1000
CRAWL_CONCURRENCY=4

# Retrieval
TOP_K=8
MIN_SCORE=0.25
