#!/usr/bin/env bash
# Reject attribution trailers that must never appear in commits.
# Blocked patterns:
#   Co-authored-by: ...          (GitHub/Claude collaboration trailers)
#   Claude-Session: ...          (Claude session URL trailers)
#   Generated with Claude ...    (Claude-generated footers)
set -euo pipefail

MSG_FILE="$1"

if grep -qiE "^co-authored-by:" "$MSG_FILE"; then
  echo "ERROR: commit-msg hook: Co-authored-by trailer is not allowed." >&2
  echo "       Remove the Co-authored-by line and retry." >&2
  exit 1
fi

if grep -qiE "^claude-session:" "$MSG_FILE"; then
  echo "ERROR: commit-msg hook: Claude-Session trailer is not allowed." >&2
  echo "       Remove the Claude-Session line and retry." >&2
  exit 1
fi

if grep -qiE "^generated with" "$MSG_FILE"; then
  echo "ERROR: commit-msg hook: 'Generated with' footer is not allowed." >&2
  echo "       Remove the Generated-with line and retry." >&2
  exit 1
fi

exit 0
